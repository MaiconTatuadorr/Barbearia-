{
  "name": "barbearia-",
  "version": "1.0.0",
  "description": "Página de agendamento online para cabeleireiro/barbearia (Cloudflare Pages + D1)",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev --local --live-reload",
    "db:migrate:local": "wrangler d1 migrations apply barbearia-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply barbearia-db --remote",
    "deploy": "wrangler pages deploy public",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiconTatuadorr/Barbearia-.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MaiconTatuadorr/Barbearia-/issues"
  },
  "homepage": "https://github.com/MaiconTatuadorr/Barbearia-#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "wrangler": "^4.144.0"
  }
}
